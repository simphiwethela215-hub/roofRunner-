# Copy to your hosting provider's environment settings. Never commit real secrets.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://your-app.example.com
DATABASE_URL=postgresql://user:password@host:5432/earnbox?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=replace_with_64_hex_characters
# Required for signed offer completion callbacks. Use a unique random value.
POSTBACK_SECRET=replace_with_a_long_random_secret
# Required admin password; use a strong unique password.
ADMIN_PASSWORD=replace_with_a_long_unique_password
